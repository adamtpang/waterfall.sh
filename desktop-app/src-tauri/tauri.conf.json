{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "waterfall",
  "version": "0.1.0",
  "identifier": "sh.waterfall.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "waterfall",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Cascade to the best model. Launch peer coding desktops.",
    "longDescription": "Native desktop for waterfall.sh: Claude quota cascade dashboard, OpenRouter routing, and launchers for CC Switch, AionUi, OpenCode, and OpenChamber.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
