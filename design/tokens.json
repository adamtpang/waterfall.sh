{
  "$description": "waterfall.sh design tokens, Ribbon direction (W3C Design Tokens). Source of truth: /design/system.json. Light-only.",
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#0a2540",
      "$description": "primary text and dark surfaces. Headlines, body emphasis, the dark pill, code blocks, and the navy closing band."
    },
    "mute": {
      "$type": "color",
      "$value": "#425466",
      "$description": "secondary text. Ledes, section subtitles, and tile copy."
    },
    "soft": {
      "$type": "color",
      "$value": "#5f6f84",
      "$description": "tertiary text. Fine print, captions, and meta. Minimum 12px."
    },
    "line": {
      "$type": "color",
      "$value": "#e3e8ee",
      "$description": "hairline. Card outlines (as 1px box-shadow), band borders, and dividers."
    },
    "tint": {
      "$type": "color",
      "$value": "#f6f9fc",
      "$description": "pale surface. The full-bleed cascade band, bento tiles, install cards, and inner-page cards."
    },
    "white": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "page canvas. Body background on every route."
    },
    "blue": {
      "$type": "color",
      "$value": "#0a6fd6",
      "$description": "accent on white. Home links, the highlighted headline phrase, focus rings, and the hard-step outline."
    },
    "accent-inner": {
      "$type": "color",
      "$value": "#0859ad",
      "$description": "accent on light tints. Inner-page accent (leaderboard, workshop, docs) so blue text stays AA on #e6f0fb and #eaf3fd tints."
    },
    "good": {
      "$type": "color",
      "$value": "#08744e",
      "$description": "savings and success. Savings figures, per-step costs, and the works-today status dot only."
    },
    "warn": {
      "$type": "color",
      "$value": "#9a5b00",
      "$description": "caution. Pilot or caution states on inner pages."
    },
    "ribbon-cyan": {
      "$type": "color",
      "$value": "#5ec6ff",
      "$description": "ribbon stop. Cascade ribbon gradient stop and the cascade line in the routing band."
    },
    "ribbon-blue": {
      "$type": "color",
      "$value": "#2f6bff",
      "$description": "ribbon stop. Cascade ribbon gradient stop and step markers."
    },
    "ribbon-violet": {
      "$type": "color",
      "$value": "#6b5cff",
      "$description": "ribbon stop. Cascade ribbon gradient stop."
    },
    "ribbon-teal": {
      "$type": "color",
      "$value": "#12c2b3",
      "$description": "ribbon stop. Cascade ribbon gradient stop."
    },
    "ribbon-mist": {
      "$type": "color",
      "$value": "#a7f3ff",
      "$description": "ribbon stop. Cascade ribbon highlight stop."
    },
    "board-bg": {
      "$type": "color",
      "$value": "#0b1220",
      "$description": "board canvas. Illustration-only sub-palette for the dark local board still. Board chat area."
    },
    "board-rail": {
      "$type": "color",
      "$value": "#08101c",
      "$description": "board rail. Illustration-only sub-palette for the dark local board still. Board sidebar, title bar, and side panel."
    },
    "board-card": {
      "$type": "color",
      "$value": "#0f1830",
      "$description": "board card. Illustration-only sub-palette for the dark local board still. Board message cards and the active project row."
    },
    "board-accent": {
      "$type": "color",
      "$value": "#5ec6ff",
      "$description": "board accent. Illustration-only sub-palette for the dark local board still. Hard-route badge and sparkline."
    },
    "board-good": {
      "$type": "color",
      "$value": "#3dd68c",
      "$description": "board success. Illustration-only sub-palette for the dark local board still. Cheap-route badge, live dots, and the saved metric."
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter Tight",
          "-apple-system",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Cascadia Code",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "display": {
        "$type": "dimension",
        "$value": "72px"
      },
      "close": {
        "$type": "dimension",
        "$value": "56px"
      },
      "h2": {
        "$type": "dimension",
        "$value": "48px"
      },
      "title": {
        "$type": "dimension",
        "$value": "28px"
      },
      "tile": {
        "$type": "dimension",
        "$value": "24px"
      },
      "lede": {
        "$type": "dimension",
        "$value": "21px"
      },
      "body": {
        "$type": "dimension",
        "$value": "17px"
      },
      "small": {
        "$type": "dimension",
        "$value": "15px"
      },
      "meta": {
        "$type": "dimension",
        "$value": "13px"
      },
      "min": {
        "$type": "dimension",
        "$value": "12px"
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      }
    },
    "tracking": {
      "display": {
        "$type": "dimension",
        "$value": "-0.035em"
      },
      "heading": {
        "$type": "dimension",
        "$value": "-0.03em"
      }
    }
  },
  "space": {
    "s8": {
      "$type": "dimension",
      "$value": "8px"
    },
    "s12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "s16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "s24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "s32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "s48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "s56": {
      "$type": "dimension",
      "$value": "56px"
    },
    "s72": {
      "$type": "dimension",
      "$value": "72px"
    },
    "s88": {
      "$type": "dimension",
      "$value": "88px"
    },
    "s112": {
      "$type": "dimension",
      "$value": "112px"
    },
    "s128": {
      "$type": "dimension",
      "$value": "128px"
    }
  },
  "radius": {
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "tile": {
      "$type": "dimension",
      "$value": "22px"
    },
    "card": {
      "$type": "dimension",
      "$value": "18px"
    },
    "board": {
      "$type": "dimension",
      "$value": "14px"
    },
    "code": {
      "$type": "dimension",
      "$value": "12px"
    }
  },
  "shadow": {
    "float": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "30px",
        "blur": "60px",
        "spread": "-20px",
        "color": "#0a254040"
      }
    }
  },
  "motion": {
    "duration": {
      "base": {
        "$type": "duration",
        "$value": "300ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      }
    }
  },
  "layout": {
    "maxWidth": {
      "$type": "dimension",
      "$value": "1200px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "32px"
    },
    "section": {
      "$type": "dimension",
      "$value": "128px"
    },
    "sectionMobile": {
      "$type": "dimension",
      "$value": "88px"
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px"
    }
  }
}
