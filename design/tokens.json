{
  "$description": "waterfall.sh design tokens (W3C Design Tokens format). Source of truth: /design/system.json. Dark-only identity.",
  "color": {
    "board": {
      "$type": "color",
      "$value": "#0b1220",
      "$description": "page canvas. Body background on every route, with at most one soft radial wash."
    },
    "board2": {
      "$type": "color",
      "$value": "#0f1830",
      "$description": "elevated surface. Cards, the price panel, and the product frame."
    },
    "rail": {
      "$type": "color",
      "$value": "#08101c",
      "$description": "deepest surface. Code blocks, table bodies, the board sidebar in the still."
    },
    "chalk": {
      "$type": "color",
      "$value": "#e9edf2",
      "$description": "primary text. Headlines, body, and primary labels."
    },
    "dust": {
      "$type": "color",
      "$value": "#aab4be",
      "$description": "secondary text. Ledes, card copy, and inactive navigation."
    },
    "faint": {
      "$type": "color",
      "$value": "#7f8c99",
      "$description": "tertiary text. Meta, captions, and labels. AA floor: never use the retired #5c6873."
    },
    "line": {
      "$type": "color",
      "$value": "#27334a",
      "$description": "structural border. One-pixel borders and rules."
    },
    "accent": {
      "$type": "color",
      "$value": "#5ec6ff",
      "$description": "waterfall blue signal. Primary buttons, links, focus rings, eyebrows, and the W."
    },
    "accent-dim": {
      "$type": "color",
      "$value": "#173447",
      "$description": "signal wash. Selected or highlighted rows and chips."
    },
    "good": {
      "$type": "color",
      "$value": "#3dd68c",
      "$description": "savings and success. Savings figures and success states only."
    },
    "warn": {
      "$type": "color",
      "$value": "#f5a524",
      "$description": "warning. Real warnings only, always with text."
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, Roboto, Helvetica, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace"
      }
    },
    "size": {
      "t12": {
        "$type": "dimension",
        "$value": "12px"
      },
      "t14": {
        "$type": "dimension",
        "$value": "14px"
      },
      "t16": {
        "$type": "dimension",
        "$value": "16px"
      },
      "t20": {
        "$type": "dimension",
        "$value": "20px"
      },
      "t28": {
        "$type": "dimension",
        "$value": "28px"
      },
      "t40": {
        "$type": "dimension",
        "$value": "40px"
      },
      "t64": {
        "$type": "dimension",
        "$value": "64px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "space": {
    "s4": {
      "$type": "dimension",
      "$value": "4px"
    },
    "s8": {
      "$type": "dimension",
      "$value": "8px"
    },
    "s12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "s16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "s24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "s32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "s48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "s72": {
      "$type": "dimension",
      "$value": "72px"
    },
    "s120": {
      "$type": "dimension",
      "$value": "120px"
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "10px"
    },
    "card": {
      "$type": "dimension",
      "$value": "14px"
    },
    "frame": {
      "$type": "dimension",
      "$value": "16px"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "200ms"
      },
      "base": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      }
    }
  },
  "layout": {
    "maxWidth": {
      "$type": "dimension",
      "$value": "1120px"
    },
    "section": {
      "$type": "dimension",
      "$value": "120px"
    },
    "sectionMobile": {
      "$type": "dimension",
      "$value": "72px"
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px"
    }
  }
}
