# Copy this file to .env (or export the variable in your shell profile) to
# enable API-mode Smart Routing -- direct calls to OpenRouter instead of
# browser automation. Without this set, the OpenRouter routing path falls
# back to the older CDP browser-automation flow.

# Get a key at https://openrouter.ai/keys (pay-as-you-go; most cheap
# coding models cost a fraction of a cent per call).
OPENROUTER_API_KEY=

# Alternative to the env var above: write the key as a single line to
# ~/.claude/openrouter_key.txt instead. Either works.
